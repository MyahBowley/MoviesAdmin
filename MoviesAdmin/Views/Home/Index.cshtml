@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Movies Administration</h1>
    <p>Welcome to my movies administration web app.</p>

    <img src="/images/logo.jpg" alt="a worm poking out of a green apple" style="width: 100px; height: 100px;" />

    <form>
        <div class="mb-3">
            <label for="adminUsername">Username</label>
            <input type="email" class="form-control" id="adminUsername" />
        </div>
        <div class="mb-3">
            <label for="adminPassword">Password</label>
            <input type="password" class="form-control" id="adminPassword" />
        </div>

        <button type="submit" class="btn btn-primary">Login</button>

    </form>
</div>

